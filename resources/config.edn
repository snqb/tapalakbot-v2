{:openrouter-key #or [#env OPENROUTER_API_KEY ""]
 :models {;; Latest models (June 2026)
          :kimi-k2.7     "moonshotai/kimi-k2.7-code"
          :glm-5.2       "z-ai/glm-5.2"
          :gemini-3.5-flash "google/gemini-3.5-flash"
          :gpt-5.4-mini  "openai/gpt-5.4-mini"
          :deepseek-v4   "deepseek/deepseek-v4-pro"
          :claude-sonnet "anthropic/claude-sonnet-4.6"
          :qwen3.7       "qwen/qwen3.7-plus"
          ;; Budget options
          :deepseek-v4-flash "deepseek/deepseek-v4-flash"
          :gemini-3.1-flash-lite "google/gemini-3.1-flash-lite"
          :gpt-5.4-nano  "openai/gpt-5.4-nano"
          ;; Legacy (keep for fallback)
          :kimi-k2       "moonshotai/kimi-k2"
          :gemini-flash  "google/gemini-2.5-flash"
          :gpt-4o        "openai/gpt-4o"}
 :jev {:model "typesafe/jev-1.13"
       :endpoint #env JEV_BASE_URL
       :batch-size 20
       :concurrency 3
       :timeout-ms 30000}
 :agent {:max-turns 8
         :max-tool-output 12000
         :compact-threshold 40000
         :keep-recent 8}}
