{:paths ["src" "resources"]
 :deps {org.clojure/clojure {:mvn/version "1.12.0"}
        org.clojure/core.async {:mvn/version "1.6.681"}
        org.clojure/tools.logging {:mvn/version "1.3.0"}
        ch.qos.logback/logback-classic {:mvn/version "1.5.12"}
        cheshire/cheshire {:mvn/version "5.13.0"}
        aero/aero {:mvn/version "1.1.6"}
        clj-harness/clj-harness {:local/root "/Users/sn/Projects/clj-harness"}
        ring/ring-core {:mvn/version "1.13.0"}
        ring/ring-jetty-adapter {:mvn/version "1.13.0"}
        ring/ring-json {:mvn/version "0.5.1"}
        com.github.seancorfield/next.jdbc {:mvn/version "1.3.1093"}
        org.xerial/sqlite-jdbc {:mvn/version "3.48.0.0"}}
 :mvn/repos {"clojars" {:url "https://repo.clojars.org"}}
 :aliases
 {:run     {:main-opts ["-m" "tapalakbot.core"]}
  :bot     {:main-opts ["-m" "tapalakbot.server"]}
  :build   {:deps {org.clojure/tools.build {:mvn/version "0.10.7"}}
            :ns-default build}
  :monitor {:main-opts ["-m" "tapalakbot.monitor.main"]}
  :repl    {:main-opts ["-r"]}}}
